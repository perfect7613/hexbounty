{
  "name": "@hexbounty/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "typecheck": "tsc --noEmit",
    "test": "hardhat test",
    "deploy:testnet": "hardhat ignition deploy ignition/modules/HexBountyEscrow.ts --network monadTestnet --verify",
    "deploy:paid-play:testnet": "hardhat ignition deploy ignition/modules/HexBountyPaidPlay.ts --parameters ignition/parameters/monad-testnet-paid-play.json --network monadTestnet --verify"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "3.1.8",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "3.0.7",
    "@openzeppelin/contracts": "5.6.1",
    "@types/mocha": "10.0.10",
    "@types/node": "24.3.0",
    "hardhat": "3.13.0",
    "typescript": "5.9.2"
  }
}
