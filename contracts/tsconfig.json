{
  "compilerOptions": {
    "target": "ES2023",
    "module": "Node20",
    "moduleResolution": "Node16",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "mocha"],
    "verbatimModuleSyntax": true
  },
  "include": [
    "hardhat.config.ts",
    "ignition/**/*.ts",
    "test/**/*.ts",
    "types/**/*.ts"
  ]
}
