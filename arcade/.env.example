# Public, browser-visible. Copy to arcade/.env.local and fill in locally.
# Never put a secret behind NEXT_PUBLIC_.

# Monad Testnet RPC. If unset, the app falls back to https://testnet-rpc.monad.xyz.
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
HEXBOUNTY_LEADERBOARD_SLUGS=tetris-amey

# Must remain 10143. Optional; the app hard-codes Monad Testnet.
NEXT_PUBLIC_CHAIN_ID=10143

# Canonical public HexBountyEscrow on Monad Testnet.
# Leave empty / invalid / the zero address to run in demo-preview mode
# (browse curated evidence, writes disabled).
NEXT_PUBLIC_HEXBOUNTY_CONTRACT=0xc3F9fb30d87CFf804F394C680Ed7856B055F7c96

# Canonical deployed and source-verified HexBountyPaidPlay on Monad Testnet.
# Leave blank / invalid / the zero address: publishing, purchases, and private
# play stay unavailable. Never invent or paste a fake address.
NEXT_PUBLIC_HEXBOUNTY_PAID_PLAY=0xef61C98BE27E1381cB7188975F8D7e938d1a0E64

# Optional public dapp origin for MetaMask / SIWE. If unset, uses the current
# browser origin, then local-dev http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Minimum 32 characters. This value is a placeholder, not a real secret.
AUTH_SESSION_SECRET=replace-with-a-long-local-dev-secret

# Server-only. UploadThing API token. Never prefix with NEXT_PUBLIC_.
# The demo uses public-read ingest and deletes each source object immediately
# after Modal accepts the reconstruction handoff.
UPLOADTHING_TOKEN=replace-with-uploadthing-token

# Server-only. Modal user-jobs HTTPS origin. Never prefix with NEXT_PUBLIC_.
HEXBOUNTY_MODAL_BASE_URL=https://ameymuke252003--hexbounty-user-jobs-api.modal.run

# Server-only. HMAC secret shared with the Modal user-jobs app. Never prefix with NEXT_PUBLIC_.
HEXBOUNTY_MODAL_HMAC_SECRET=replace-with-modal-hmac-secret
