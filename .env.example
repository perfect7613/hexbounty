# HexBounty environment template. Public defaults and placeholders only.
# Copy to `.env` for tooling and keep the real file private.

# Public Monad Testnet configuration.
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_HEXBOUNTY_CONTRACT=0xc3F9fb30d87CFf804F394C680Ed7856B055F7c96
NEXT_PUBLIC_HEXBOUNTY_PAID_PLAY=0xef61C98BE27E1381cB7188975F8D7e938d1a0E64

# Contract deployment. Use a throwaway testnet wallet only.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_DEPLOYER_PRIVATE_KEY=replace-with-testnet-private-key
MONAD_EXPLORER_API_KEY=replace-with-explorer-key

# Optional operator integrations.
UPSTASH_REDIS_REST_URL=https://redis-endpoint.example
UPSTASH_REDIS_REST_TOKEN=replace-with-token
GITHUB_TOKEN=replace-with-token
MODAL_TOKEN_ID=replace-with-modal-token-id
MODAL_TOKEN_SECRET=replace-with-modal-token-secret
HEXBOUNTY_WORKSPACES=/workspaces
